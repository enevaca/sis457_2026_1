@model WebMinerva.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<h1>Crear Producto</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label class="control-label">Unidades de Medida</label>
                <select asp-for="IdUnidadMedida" class="form-select" asp-items="ViewBag.UnidadesMedida" required>
                    <option disabled selected value="">Seleccione un elemento</option>
                </select>
                <span asp-validation-for="IdUnidadMedida" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Código</label>
                <input asp-for="Codigo" class="form-control" maxlength="20" required />
                <span asp-validation-for="Codigo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Descripción</label>
                <input asp-for="Descripcion" class="form-control" maxlength="200" required />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Saldo</label>
                <input asp-for="Saldo" class="form-control" type="number" required />
                <span asp-validation-for="Saldo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Precio de Venta</label>
                <input asp-for="PrecioVenta" class="form-control" type="number" required />
                <span asp-validation-for="PrecioVenta" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-floppy-disk" aria-hidden="true"></i> Guardar
                </button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index"><i class="fa fa-arrow-left" aria-hidden="true"></i> Volver a la lista</a>
</div>
